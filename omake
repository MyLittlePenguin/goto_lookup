#!/usr/bin/env utop
#require "unix"
#require "compiler-libs.toplevel"

let arg = if Array.length Sys.argv > 1 then Sys.argv.(1) else ""

let cmd command =
  match Unix.system command with
  | WEXITED 0 -> ()
  | WEXITED code -> exit code
  | _ -> exit 420

let echo msg =
  cmd @@ "echo " ^ msg

let write filename content =
  let oc = open_out filename in
  output_string oc content;
  close_out oc

let read filename =
  let ic = open_in filename in
  let n = in_channel_length ic in
  let content = really_input_string ic n in
  close_in ic;
  content;;

let script = if Sys.file_exists "build.ml" then "build.ml" else "build.ocaml";;

Topdirs.dir_use Format.std_formatter script

let () = run arg |> ignore
