#!/usr/bin/env utop
#use "omake.ocaml"

let version_file = "version.txt"

let rec run = function
  | "" | "build" | "compile" ->
    run "update_version";
    cmd "dune build"
  | "release" ->
    run "create_version";
    cmd "dune build --profile=release"
  | "run" ->
    run "create_version";
    cmd "dune exec ./bin/main.exe"
  | "version" ->
    cmd "cat version.txt"
  | "install" ->
    run "release";
    cmd "dune install"
  | "test" ->
    cmd "dune test"

  | "create_version" ->
    write "bin/version.ml" @@ String.concat "" [
      "let number = \"";
      String.trim @@ read version_file;
      "\"\n"
    ]

  | "update_version" ->
    let version = String.trim @@ read version_file in
    let parts = String.split_on_char '.' version in
    let new_version = String.concat "." [
      List.nth parts 0;
      List.nth parts 1;
      List.nth parts 2 |> int_of_string |> (+) 1 |> string_of_int;
    ] in
    write version_file new_version;
    run "create_version";

  | _ -> exit 404;;

let () = run arg |> ignore
